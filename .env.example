# Public API origin used by the Vite frontend and Android build.
# Leave empty for local development through the Express server.
VITE_API_BASE_URL=https://limitup-api.example.workers.dev
# For GitHub Pages deployment, use the repository Pages URL and static snapshots:
# VITE_API_MODE=static
# VITE_API_BASE_URL=https://hahapokar.github.io/limitup

# Used only by the local/server-side Express API, not exposed to the browser.
# PORT=3008
# CORS_ORIGINS=https://localhost,http://localhost:5173
